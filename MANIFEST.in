include Dockerfile README.md LICENSE pyproject.toml setup.py .dockerignore
include docker-compose.yml docker-compose.agents.yml docker-compose.gpu.yml docker-compose.pdf-worker.yml
include experiments/dnb/*.py experiments/dnb/start.sh
recursive-include requirements *
recursive-include browser-search *
recursive-include workers *
recursive-include format-worker *
recursive-include media-worker *
recursive-include docling-worker *
recursive-include docker *
recursive-include adapters *
recursive-include scripts *
recursive-include docs *
recursive-include evaluations *
global-exclude *.py[cod]
global-exclude __pycache__
prune src/dethrottled/_stack

include AGENTS.md SKILL-dethrottled.md THIRD-PARTY-NOTICES.md

recursive-include src/dethrottled/licenses *.txt

exclude scripts/bootstrap scripts/ensure-dnb-keys scripts/seed-model-cache
exclude scripts/worker-idle-stop scripts/worker-wake-proxy
