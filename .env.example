# Copy to .env and edit. Every value here has a working default; this file
# exists so you can change one without editing the compose file.

# Host port the API is published on. See DETHROTTLED_BIND below for the
# address, and docs/OPERATIONS.md before you change it.
DETHROTTLED_PORT=8787
# Address the API is published on. Loopback by default because the service
# is unauthenticated and will fetch whatever it is asked to. Set it to
# 0.0.0.0 only on a network you trust.
DETHROTTLED_BIND=127.0.0.1

# DNB (DETHROTTLED_DNB=1). The core accepts the forwarded
# caller-identity header only from these adapter peers. Default is loopback;
# set the adapter host/subnet if the REST or MCP bridge runs in another
# container or on another trusted host. Keep the core itself off the LAN.
# DETHROTTLED_ADAPTER_CIDRS=127.0.0.1/32,::1/128

# DNB. Bound drive-session/checkpoint ownership store and durable
# completed-operation journal. Defaults to ${DETHROTTLED_DATA_DIR}/dnb; storage
# errors fail closed for identified drive requests.
# DETHROTTLED_DNB_STATE_DIR=/var/lib/dethrottled/dnb

# The renderer's credential. Crawl4AI refuses to listen on a network interface
# without one, which is why this exists at all. It guards container-to-container
# traffic on a private bridge; the renderer is never published to the host.
CRAWL4AI_TOKEN=dethrottled-compose-local

# Optional local deployment tuning. The defaults work without this file.
# Set true only if you intentionally render LAN URLs with Crawl4AI.
CRAWL4AI_ALLOW_INTERNAL_URLS=false
DETHROTTLED_EXTRACT_CACHE_CHARS=1000000
# Direct/TLS connection establishment; response reads retain their own allowance.
DETHROTTLED_CONNECT_TIMEOUT=2
# DETHROTTLED_USER_AGENT=dethrottled/1.8.1 (automated fetcher)

# Optional worker profiles. The base Compose file starts DNB automatically.
# COMPOSE_PROFILES=layout,media

# Worker CPU threads, as a ratio of the host's thread count. scripts/compose-auto.sh
# resolves this per machine, so nothing is pinned to one box. 0.40 is the measured
# knee for both docling and whisper (see that script for the benchmark table).
# DETHROTTLED_WORKER_THREAD_RATIO=0.40
# Optional ceiling, useful on very large hosts where the curve is already flat.
# DETHROTTLED_WORKER_THREADS_MAX=8
# Set this to skip the calculation entirely.
# DETHROTTLED_WORKER_THREADS=4

# The corpus embedding models and tokenizers are baked into the API image.
# Compose does not need a model directory or Hugging Face token. The data
# volume holds cache/corpus state; keep it when rebuilding or upgrading.

# Compose discovers started local workers; no endpoint setup is needed.
# Use --profile media, --profile layout, or --profile full for model workers.
DETHROTTLED_AUTO_WORKERS=1
# Explicit custom URL overrides discovery; off disables an individual worker.
# Native PDF tables/OCR work without the layout profile.
DETHROTTLED_LAYOUT_WORKER_URL=

# Optional metered discovery. Keys stay server-side; an explicit engines request
# (for example web,exa) is also required. Default profiles never spend these keys.
DETHROTTLED_EXA_API_KEY=
DETHROTTLED_TAVILY_API_KEY=
DETHROTTLED_PARALLEL_API_KEY=

# Broad-format fallback is included in the default stack.
# Optional speech uses the media profile and is discovered automatically.
DETHROTTLED_MEDIA_WORKER_URL=
DETHROTTLED_FORMAT_WORKER_URL=
# Compose enables the second corpus index; disable on memory-constrained systems.
DETHROTTLED_MULTILINGUAL_CORPUS=1
# -1 removes the hourly local-render quota; 0 disables it; positive values cap it.
DETHROTTLED_CRAWL4AI_BUDGET=-1
DETHROTTLED_RENDER_CONCURRENCY=2

# Browser graphics profile: mesa enables tested software WebGL; default uses original args.
DETHROTTLED_BROWSER_GRAPHICS=auto
# Observed navigation recipes; off is useful for controlled comparisons.
DETHROTTLED_BROWSER_RECOVERY=auto

# Automatic recovery admission budget; in-flight requests retain their transport timeout.
DETHROTTLED_READ_PLAN_SECONDS=30

# Native HaGeZi Multi PRO domain filtering across managed acquisition workers.
# 0 disables filtering and all automatic list-update activity. Default: 1.
DETHROTTLED_ADBLOCK=1

# DNB signs requests with a stack-owned key generated on first start.
# Optional REST/MCP overlay: supply a caller registry readable by both adapters
# and the API. Keep this file out of the checkout.
# DETHROTTLED_TOKEN_REGISTRY_FILE=/etc/dethrottled-access/tokens.json
# DETHROTTLED_REGISTRY_GID=10001

# Compose enables Ettin and seeds its project cache on first start.
# DETHROTTLED_RERANK=0
